{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "components",
    "title": "Components Table",
    "description": "One row per resolved node",
    "type": "object",
    "additionalProperties": false,
    "required": ["ref", "purl", "package", "is_root", "depth", "via", "route"],
    "properties": {
        "ref": {
            "description": "The Package reference",
            "type": ["string"]
        },
        "purl": {
            "description": "The Package URL with version",
            "type": ["string", "null"],
            "pattern": "^pkg:[a-z]+/."
        },
        "package": {
            "description": "The Package URL without version",
            "type": ["string", "null"],
            "pattern": "^pkg:[a-z]+/."
        },
        "is_root": {
            "description": "True when the component is the root",
            "type": "boolean"
        },
        "depth": {
            "description": "The dependency depth",
            "type": ["integer", "null"]
        },
        "via": {
            "description": "Provenance chain leading to a transitive dependency",
            "type": ["string", "null"]
        },
        "route": {
            "description": "Route the Package followed to be resolved",
            "type": "string",
            "enum": ["registry", "repository", "unsupported", "no_purl"]
        }
    }
}
