{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "publisher-history",
    "title": "",
    "description": "",
    "type": "object",
    "additionalProperties": false,
    "required": ["purl", "publisher_hid", "published_at", "publisher_kind", 
    "maintainers_hids", "owners_current_only", "source", "observed_at", "release"],
    "properties": {
        "purl": {
            "description": "The Package URL with version",
            "type": "string",
            "pattern": "^pkg:[a-z]+/."
        },
        "published_at": {
            "description": "From the registry, the time map on npm or created_at on crates.io",
            "type": "string",
            "format": "date-time"
        },
        "publisher_hid": {
            "description": "Keyed hash of the publishing account, null where the registry does not expose it",
            "type": ["string", "null"]
        },
        "publisher_kind": {
            "description": "Kind of the publisher",
            "type": "string",
            "enum": ["account", "trusted_publisher", "unknown"]
        },
        "maintainers_hids": {
            "description": "Keyed hashes of the maintainers field at that version on npm, or of the current owners on crates.io",
            "type": "array",
            "items":{
                "type": "string"
            }
        },
        "owners_current_only": {
            "description": "True when the owners could only be observed as they are today",
            "type": "boolean"
        },
        "source": {
            "description": "Where the data comes from",
            "type": "string",
            "enum": ["live", "wayback", "dump"]
        },
        "observed_at": {
            "description": "When the history was computed",
            "type": "string",
            "format": "date-time"
        },
        "release": {
            "description": "The data set release identifier",
            "type": "string"
        }
    }
}