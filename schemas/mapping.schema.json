{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "mapping",
    "title": "",
    "description": "",
    "type": "object",
    "additionalProperties": true,
    "required": ["purl", "forge", 
    "confidence", "sources_agreeing", "sources", "observed_at", "release"],
    "properties": {
        "purl": {
            "description": "",
            "type": "string"
        },
        "repository": {
            "description": "",
            "type": "string"
        },
        "forge": {
            "description": "",
            "type": "string",
            "enum": ["github", "gitlab", "codeberg", "sourcehut", "gitea", "other", "unknown"]
        },
        "confidence": {
            "description": "",
            "type": "string",
            "enum": ["high", "medium", "low", "none"]
        },
        "sources_agreeing": {
            "description": "",
            "type": "integer"
        },
        "sources": {
            "description": "",
            "type": "array"
        },
        "observed_at": {
            "description": "",
            "type": "string",
            "format": "date-time"
        },
        "release": {
            "description": "",
            "type": "string"
        }
    }
}