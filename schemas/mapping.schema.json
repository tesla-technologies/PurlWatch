{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "mapping",
    "title": "Mapping Table",
    "description": "One row per package, without version, per release",
    "type": "object",
    "additionalProperties": false,
    "required": ["purl", "repository", "forge", 
    "confidence", "sources_agreeing", "sources", "observed_at", "release"],
    "properties": {
        "purl": {
            "description": "The Package URL with version",
            "type": "string",
            "pattern": "^pkg:[a-z]+/."
        },
        "repository": {
            "description": "The normalised clone URL",
            "type": ["string", "null"]
        },
        "forge": {
            "description": "Possible forges",
            "type": "string",
            "enum": ["github", "gitlab", "codeberg", "sourcehut", "gitea", "other", "unknown"]
        },
        "confidence": {
            "description": "Confidence level",
            "type": "string",
            "enum": ["high", "medium", "low", "none"]
        },
        "sources_agreeing": {
            "description": "How many consulted sources agree with the resolved repository",
            "type": "integer",
            "minimum": 0 
        },
        "sources": {
            "description": "Which sources were consulted",
            "type": "array",
            "items": {
                "enum": ["registry", "ecosystems", "depsdev", "provenance", "sbom"]
            }
        },
        "observed_at": {
            "description": "When the mapping was computed",
            "type": "string",
            "format": "date-time"
        },
        "release": {
            "description": "The data set release identifier",
            "type": "string"
        }
    }
}